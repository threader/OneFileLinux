[submodule "buildroot"]
	path = buildroot
	url = https://github.com/threader/buildroot
	branch = master_ofl
[submodule "kernel-hardening-checker"]
	path = kernel-hardening-checker
	url = https://github.com/a13xp0p0v/kernel-hardening-checker
[submodule "hardened_malloc"]
	path = hardened_malloc
	url = https://github.com/GrapheneOS/hardened_malloc.git
[submodule "pkgsrc"]
	path = pkgsrc
	url = https://github.com/threader/pkgsrc
	branch = ofl_pkgsrc
#[submodule "linux"]
#	path = linux
#	url = https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/
#	branch = linux-rolling-stable
[submodule "debian"]
	path = debian
	url = https://salsa.debian.org/kernel-team/linux.git
	branch = debian/latest
[submodule "fil-c"]
	path = fil-c
	url = https://github.com/pizlonator/fil-c
	branch = deluge
